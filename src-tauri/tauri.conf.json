{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenShores Launcher",
  "version": "1.0.0",
  "identifier": "net.openshores.launcher",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../build/icon.ico"]
  }
}
